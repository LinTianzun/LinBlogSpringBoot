# ═══════════════════════════════════════════════════════════════════════
# LinBlog 部署环境变量
# 变量名与开发文档 §4.3 逐字一致；deploy 专用变量集中在文末（备份/反代）。
# 用法：cp .env.example .env，改掉所有 change-me，然后 docker compose up -d --build
# ═══════════════════════════════════════════════════════════════════════

# ── 站点与反代（deploy 专用）─────────────────────────────────────────────
# 对外域名（Caddy 自动 HTTPS 的目标）。本地调试填 localhost，并把 CADDYFILE 改为 Caddyfile.local
SITE_DOMAIN=blog.example.com
# 选择挂载进 caddy 容器的配置文件：Caddyfile（生产 HTTPS）/ Caddyfile.local（本地 http，仅 :80）
CADDYFILE=Caddyfile
# 容器时区（影响备份 cron 触发时间与日志时间戳）
TZ=Asia/Shanghai

# ── MySQL 容器初始化（deploy 专用）───────────────────────────────────────
# root 密码（仅 mysql 首次初始化数据卷时生效，改后需删除卷重建）
MYSQL_ROOT_PASSWORD=change-me-root
# 应用库名。注意：必须与下方 DB_URL 里的库名保持一致
MYSQL_DATABASE=springlinblog

# ── 后端（§4.3，application.yml 按这些变量名读取）────────────────────────
# 服务端口；Caddyfile 上游固定写死 backend:8080，若改此处必须同步改 Caddyfile
SERVER_PORT=8080
# JDBC 连接串；compose 网络内数据库主机名固定为 mysql:3306；库名须与 MYSQL_DATABASE 一致
DB_URL=jdbc:mysql://mysql:3306/springlinblog?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
# 数据库账号（mysql 容器会以它创建同名用户与库）
DB_USERNAME=springlinblog
DB_PASSWORD=change-me-db
# JWT 签名密钥：必填且 ≥32 字符。生成：openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-jwt-access-secret-min-32-chars
# access 令牌有效期（ISO-8601 duration）/ refresh 有效期（天）
JWT_ACCESS_TTL=PT15M
REFRESH_TTL_DAYS=7
# Cookie 域：跨子域共享登录时才设（如 .example.com）；单域名部署留空
COOKIE_DOMAIN=
# Cookie 是否仅 HTTPS：生产必须 true；本地 http 调试（Caddyfile.local）改 false
COOKIE_SECURE=true
# 允许的精确来源，逗号分隔（含协议，new URL 校验），XSRF Origin 校验与 CORS 用；必填
ALLOWED_ORIGINS=https://blog.example.com
# 对外公开地址：生成 sitemap / 邮件链接；留空则回退 ALLOWED_ORIGINS 第一个
PUBLIC_URL=https://blog.example.com
# 存储驱动：local（磁盘）/ s3（MinIO）
STORAGE_DRIVER=local
# 本地存储目录：容器内相对 WORKDIR /app 解析为 /app/data/storage（compose 已挂同名卷）；
# 本地开发（非容器）用默认相对路径即可
STORAGE_LOCAL_DIR=./data/storage
# 以下 S3_* 仅 STORAGE_DRIVER=s3 时必填
S3_ENDPOINT=
S3_BUCKET=
S3_AK=
S3_SK=
# 缩略图宽度档位（落盘 WebP）
THUMB_WIDTHS=320,640,1280
# 单文件上传上限
UPLOAD_MAX_BYTES=20MB
# 浏览统计去重窗口（分钟）
VIEW_DEDUP_MINUTES=30
# 请求审计保留天数 / 回收站保留天数（到期由定时任务清理）
AUDIT_RETENTION_DAYS=90
TRASH_RETENTION_DAYS=30
# GeoIP 归属解析（请求审计的 geo 字段），默认关闭
GEOIP_ENABLED=false
# SMTP 邮件：配置 SMTP_HOST 则 SMTP_FROM 必填；全部留空 = 禁用邮件（重置密码不可用）
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 登录 / 重置密码限流，单位：次/分钟/IP（文档 §4.3 默认 5/min；值格式需与 backend 实现对齐）
RATE_LIMIT_LOGIN=5
RATE_LIMIT_RESET=5

# ── 备份（deploy 专用，backup.sh 读取）───────────────────────────────────
# 备份滚动保留天数
BACKUP_KEEP_DAYS=14
# 备份区容量上限（字节）：2GiB=2147483648；用量 ≥80% 写 WARN 日志，≥100% 写 ERROR
BACKUP_QUOTA_BYTES=2147483648
# 异地副本目标目录（backup 容器内路径）。留空=禁用；
# compose 已把 ./data/offsite 挂到 /offsite，填 /offsite 即启用；
# 要复制到另一块盘，改 compose 中 /offsite 的宿主机挂载路径即可
OFFSITE_BACKUP_DIR=
