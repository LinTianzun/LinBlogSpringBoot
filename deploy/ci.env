# LinBlog CI/e2e 专用环境变量（占位密钥，仅用于 CI 容器，勿用于生产）
# e2e job 通过 `cp ci.env .env` 后 docker compose up；Caddyfile.local 走 http，仅 :80
MYSQL_ROOT_PASSWORD=ci-root-password
MYSQL_DATABASE=springlinblog
DB_URL=jdbc:mysql://mysql:3306/springlinblog?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
DB_USERNAME=springlinblog
DB_PASSWORD=ci-db-password
JWT_ACCESS_SECRET=ci-only-jwt-access-secret-0123456789abcdef
JWT_ACCESS_TTL=PT15M
REFRESH_TTL_DAYS=7
COOKIE_DOMAIN=
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost
PUBLIC_URL=http://localhost
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/storage
S3_ENDPOINT=
S3_BUCKET=
S3_AK=
S3_SK=
THUMB_WIDTHS=320,640,1280
UPLOAD_MAX_BYTES=20MB
VIEW_DEDUP_MINUTES=30
AUDIT_RETENTION_DAYS=90
TRASH_RETENTION_DAYS=30
GEOIP_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RATE_LIMIT_LOGIN=5
RATE_LIMIT_RESET=5
SITE_DOMAIN=localhost
CADDYFILE=Caddyfile.local
BACKUP_KEEP_DAYS=14
BACKUP_QUOTA_BYTES=2147483648
OFFSITE_BACKUP_DIR=
TZ=Asia/Shanghai
