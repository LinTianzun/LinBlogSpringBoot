# =====================================================================
# LinBlog 后端环境变量样例（开发文档 §4.3，命名逐字一致）
# 用法：复制为 .env 并按需修改；生产环境请直接注入环境变量。
# =====================================================================

SERVER_PORT=8080

# —— 数据库（启动强校验：缺失拒绝启动）——
DB_URL=jdbc:mysql://localhost:3306/springlinblog?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=

# —— JWT（启动强校验：缺失或 <32 字符拒绝启动）——
JWT_ACCESS_SECRET=change-me-to-a-random-32-chars-min-secret
JWT_ACCESS_TTL=PT15M
REFRESH_TTL_DAYS=7

# —— Cookie（跨子域部署时设 COOKIE_DOMAIN；本地 HTTP 开发设 COOKIE_SECURE=false）——
COOKIE_DOMAIN=
COOKIE_SECURE=true

# —— CORS（启动强校验：缺失或含非法 URL 拒绝启动；逗号分隔精确来源）——
ALLOWED_ORIGINS=http://localhost:5173

# —— 对外地址（缺省回退 ALLOWED_ORIGINS[0]；生成 sitemap / 邮件链接）——
PUBLIC_URL=

# —— 存储 ——
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/storage
S3_ENDPOINT=
S3_BUCKET=
S3_AK=
S3_SK=

# —— 图片管线 ——
THUMB_WIDTHS=320,640,1280
UPLOAD_MAX_BYTES=20MB

# —— 统计与清理 ——
VIEW_DEDUP_MINUTES=30
AUDIT_RETENTION_DAYS=90
TRASH_RETENTION_DAYS=30

# —— GeoIP（默认关闭）——
GEOIP_ENABLED=false

# —— SMTP（配置 SMTP_HOST 则 SMTP_FROM 必填；未配置时重置链接打日志）——
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# —— 限流（IP 维，次/分钟）——
RATE_LIMIT_LOGIN=5
RATE_LIMIT_RESET=5
