{
  "name": "linblog-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "gen:api": "openapi-typescript ./openapi.json -o src/types/api.d.ts",
    "sizecheck": "size-limit"
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-link": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@tiptap/vue-3": "^3.32.2",
    "naive-ui": "^2.45.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/ion": "^1.2.7",
    "@size-limit/preset-app": "^14.3.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.0",
    "less": "^4.2.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.0",
    "size-limit": "^14.3.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1",
    "unplugin-icons": "^24.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.3.0"
  }
}
